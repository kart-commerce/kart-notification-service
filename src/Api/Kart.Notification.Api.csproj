<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- No Swagger/OpenAPI: api-contract.yaml is deliberately empty - this service is consumer-only, no public or internal-ops API surface (architecture.md's Boundary Rationale). Only /health/*  and /metrics are exposed, via plain minimal-API health-check/Prometheus mapping. -->

  <!--
    kart-conventions.md Observability section: Kart.Shared.Observability wires Serilog + the
    OpenTelemetry SDK behind one DI call - never reimplemented per service. Kart.Shared.ErrorHandling
    wires the single global exception handler + ProblemDetails factory. Kart.Shared.Configuration
    wires the GlobalConfig external-secrets-file bootstrap (see appsettings.Local.json.example).
  -->
  <ItemGroup>
    <PackageReference Include="Kart.Shared.Configuration" Version="0.1.0" />
    <PackageReference Include="Kart.Shared.ErrorHandling" Version="0.1.0" />
    <PackageReference Include="Kart.Shared.Observability" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Kart.Notification.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Kart.Notification.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    contracts/message-bus-manifest.json is this service's single source of truth for its
    RabbitMQ topology — copied here so RabbitMqOptions.ManifestPath (resolved against
    AppContext.BaseDirectory) finds it at runtime without a "../../contracts" relative
    path that would break once this service is deployed as its own container image.
  -->
  <ItemGroup>
    <Content Include="..\..\contracts\message-bus-manifest.json" Link="message-bus-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
