# Copy to .env (gitignored) and fill in real values for your machine.
# scripts/migrate.sh loads this automatically - only needed if your local Postgres differs from
# NotificationDbContextFactory.cs's localhost:5433/postgres/postgres default (docker-compose.yml
# maps the local Postgres container to host port 5433, not 5432, to avoid colliding with other
# locally-running Postgres instances).
# Keep the quotes: migrate.sh sources this file with bash, and an unquoted ";" in the connection
# string is parsed as a command separator, silently truncating it.
NOTIFICATION_DB_CONNECTION_STRING="Host=localhost;Port=5433;Database=kart_notification;Username=postgres;Password=postgres"
