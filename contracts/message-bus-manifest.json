    { "name": "tracking.exchange", "type": "topic", "durable": true },
    { "name": "user.exchange", "type": "topic", "durable": true }
  ],
  "publishedEvents": [
    { "eventType": "NotificationSent", "exchange": "notification.exchange", "routingKey": "notification.notification.sent" }
  ],
