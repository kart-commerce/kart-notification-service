{
  "service": "kart-notification-service",
  "exchanges": [
    { "name": "notification.exchange", "type": "topic", "durable": true },
    { "name": "notification.dlx", "type": "topic", "durable": true }
  ],
  "externalExchanges": [
    { "name": "order.exchange", "type": "topic", "durable": true },
    { "name": "payment.exchange", "type": "topic", "durable": true },
    { "name": "wishlist.exchange", "type": "topic", "durable": true },
